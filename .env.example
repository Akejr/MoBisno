# Copiar para `.env` e preencher. Nada que comece por VITE_ pode ser segredo:
# essas vão compiladas no pacote do navegador. As restantes só o servidor lê.

# Base de dados
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pagamentos (Wiza). O segredo do webhook é inventado por você:
# node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
WIPAY_CLIENT_ID=
WIPAY_CLIENT_SECRET=
WIPAY_WEBHOOK_SECRET=

# SMS de confirmação do telemóvel (Nsangu). Sem isto, quem cria conta não recebe
# o código e fica com a loja por publicar até a equipa confirmar o número à mão.
NSANGU_API_KEY=

# IA (OpenRouter) — o assistente e os textos de SEO que ele gera.
OPENROUTER_API_KEY=

# Email (Resend)
RESEND_API_KEY=

# Opcionais (têm valor por omissão)
# SUPABASE_URL=
# WIPAY_BASE_URL=https://api.wipay.ao
# VERO_BASE_URL=https://api.vero.ao
# NSANGU_BASE_URL=https://api.nsangu.com
# RESEND_FROM=MôBisno <vendas@mobisno.store>
# Identificador de https://openrouter.ai/models (fornecedor/modelo).
# OPENROUTER_MODEL=openai/gpt-4o-mini
# GOOGLE_SITE_VERIFICATION=
