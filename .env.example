# Copiar para `.env` e preencher. Nada que comece por VITE_ pode ser segredo:
# essas vão compiladas no pacote do navegador. As restantes só o servidor lê.

# Base de dados
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pagamentos (Wiza). O segredo do webhook é inventado por você:
# node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
WIPAY_CLIENT_ID=
WIPAY_CLIENT_SECRET=
WIPAY_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=

# Assistente
OPENAI_API_KEY=

# Opcionais (têm valor por omissão)
# SUPABASE_URL=
# WIPAY_BASE_URL=https://api.wipay.ao
# VERO_BASE_URL=https://api.vero.ao
# RESEND_FROM=MôBisno <vendas@mobisno.store>
# OPENAI_MODEL=gpt-5.4-mini
# GOOGLE_SITE_VERIFICATION=
